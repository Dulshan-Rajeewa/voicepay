PORT=3001
NODE_ENV=development
APP_BASE_URL=http://localhost:3001
CLIENT_ORIGIN=http://localhost:5173
ORIGIN=http://localhost:5173
# Comma-separated browser origins allowed for WebAuthn. Use the stable Vercel
# production URL, not a preview URL.
ALLOWED_ORIGINS=http://localhost:5173
RP_ID=localhost
RP_NAME=VoicePay
# Set false only for local demos. Production must keep device confirmation enabled.
REQUIRE_DEVICE_AUTH=true
# Production refuses false unless ALLOW_DEMO_MODE=true. Never enable demo mode in production.
ALLOW_DEMO_MODE=false
USE_MOCK_PAYPAL=true
MAX_PAYMENT_USD=100
TRANSACTION_LOG_PATH=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
CONTACT_NIMAL_EMAIL=nimal-sandbox@example.com
CONTACT_SARA_EMAIL=sara-sandbox@example.com
CONTACT_ALEX_EMAIL=alex-sandbox@example.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_VAULT_ID=
CREDENTIAL_STORE_PATH=

# Use file for local development and hackathon judges. Use firestore in production.
STORAGE_DRIVER=file
# For Vercel/Render, set STORAGE_DRIVER=firestore and paste the base64-encoded
# contents of serviceAccount.json into FIREBASE_SERVICE_ACCOUNT_B64. Never commit
# serviceAccount.json or put its JSON directly in a tracked file.
FIREBASE_SERVICE_ACCOUNT_B64=
# Local development only: path to the downloaded service-account JSON file.
GOOGLE_APPLICATION_CREDENTIALS=
